# Copy to .env and fill in. All values are read server-side (process.env).
# On the server the real file lives at /opt/huskydrilling/.env.

# Google Maps (contact + service area maps)
MAPS_API_KEY=
MAP_ID=

# Cloudflare Turnstile (contact form spam check)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# EmailJS (contact form delivery)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Drilling stats in the hero (optional; falls back to built-in defaults when unset)
DRILLING_STATS_API_URL=
DRILLING_STATS_API_KEY=
